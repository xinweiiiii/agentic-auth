# Agentic Authorization SDK — backend configuration.
# Copy to `.env` (git-ignored) and adjust. Every key is read with the
# AGENTIC_AUTH_ prefix by app/config.py.

# ---------------------------------------------------------------- Phase 1
AGENTIC_AUTH_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agentic_auth
AGENTIC_AUTH_REDIS_URL=redis://localhost:6379/0

# Admin bearer for every control-plane and consent write. Replaced by
# principal-bound identity in Phase 4 — until then, treat it as a shared secret.
AGENTIC_AUTH_ADMIN_TOKEN=dev-admin-token

# RFC 9728 capability discovery timeout, seconds.
AGENTIC_AUTH_DISCOVERY_TIMEOUT_SECONDS=5

# ---------------------------------------------------- Phase 2 (runtime plane)

# `iss` on every issued token.
AGENTIC_AUTH_ISSUER=agentic-auth

# Ed25519 private key, PEM.
#
#   openssl genpkey -algorithm ED25519 -out issuer-key.pem
#
# LEAVE THIS EMPTY ONLY IN DEVELOPMENT. An empty value generates an ephemeral
# keypair at startup and logs it as ephemeral: every token it signed stops
# verifying when the process restarts, and two replicas will not agree. That is
# loud on purpose — a silently rotating issuer key is far worse than a noisy one.
AGENTIC_AUTH_ISSUER_PRIVATE_KEY=

# Key id published in the JWKS and stamped in each token header. Defaults to a
# thumbprint of the public key, which is stable across restarts for a fixed key.
AGENTIC_AUTH_ISSUER_KID=

# Hop-token lifetime, seconds. Long enough for a slow upstream, short enough that
# the Redis single-use (`jti`) set stays small.
AGENTIC_AUTH_HOP_TOKEN_TTL_SECONDS=60

# Session lifetime, seconds. A session pins its policy version for this whole
# window; sized to one piece of agent work, not to a user login.
AGENTIC_AUTH_SESSION_TTL_SECONDS=1800

# Decision cache TTL, seconds. The policy version is part of the cache key, so a
# pinned session structurally cannot read another version's entry.
AGENTIC_AUTH_DECISION_CACHE_TTL_SECONDS=30

# NOTE: observe mode is per-enforcement-point, NOT deployment-wide — see
# AGENTIC_AUTH_SIDECAR_OBSERVE_MODE below. The PDP always decides and always records,
# which is what makes the observe-mode report a trustworthy prediction of enforcement.
# Read that report with GET /v1/decisions?outcome=deny&enforced=false before turning a
# sidecar from observing to enforcing.

# ------------------------------------------------------------- Sidecar PEP
# Read by `agentic-auth-sidecar` when no --config file is given. A config file
# is usually clearer; see https://authzai.dev/how-to/deploy-the-sidecar-pep.

AGENTIC_AUTH_SIDECAR_PDP_URL=http://127.0.0.1:8099
AGENTIC_AUTH_SIDECAR_LISTEN_ADDR=127.0.0.1:8081
AGENTIC_AUTH_SIDECAR_OBSERVE_MODE=false

# JSON. Each entry is a URL string, or an object with url/target/data_class.
# A path prefix with no target and no data_class is BLOCKED rather than guessed,
# unless the caller supplies X-Agentic-Target / X-Agentic-Data-Class.
AGENTIC_AUTH_SIDECAR_UPSTREAM_MAP={"/kb": {"url": "http://127.0.0.1:9000", "target": "mcp://kb.internal/search", "data_class": "kb.public"}}

# ------------------------------------------------------ Phase 3 (audit plane)

# Read-only bearer for GET /v1/audit/*. Empty disables it; the admin token is always
# accepted. Give auditors this one, not the admin token.
AGENTIC_AUTH_AUDIT_READ_TOKEN=

# Bound on the audit append + commit, seconds. An allowed call whose record cannot be
# committed in time is refused (AUDIT_UNAVAILABLE), never dispatched without a record.
AGENTIC_AUTH_AUDIT_WRITE_TIMEOUT_SECONDS=1.0

# Serve Prometheus metrics at /metrics. Internal network only; labels carry no identities.
AGENTIC_AUTH_METRICS_ENABLED=true

# With more than one uvicorn/gunicorn worker, point this at an empty writable directory so
# /metrics aggregates every worker. Unset for the single-process default.
# PROMETHEUS_MULTIPROC_DIR=/var/run/agentic-auth-metrics

# Edge recording for CI drift detection. `agentic-auth drift record` sets this for the test
# run it wraps; the sidecar and SDK append one event per call when it is set. Recording is
# passive — it never changes what is forwarded or blocked.
# AGENTIC_AUTH_TRACE_PATH=./edge-events.jsonl
# AGENTIC_AUTH_SIDECAR_TRACE_PATH=./edge-events.jsonl   # sidecar-specific override

# ------------------------------------------ Phase 4 (transaction tokens, taint, identity)
# Three independent controls. With all three off, Phase 1-3 behaviour is unchanged.

# Privileged tool calls need a call-bound transaction token (POST /v1/token/transaction).
# false -> the route answers 404 and the sidecar/SDK never buffer or mint.
AGENTIC_AUTH_TRANSACTION_TOKENS_ENABLED=true

# Return TAINTED_INTO_PRIVILEGED. false -> taint is still derived and RECORDED (tune first).
AGENTIC_AUTH_TAINT_ENFORCEMENT_ENABLED=true

# Require an actor_token (proof of possession of the enrolled key) at every exchange and
# refuse agents with no live trust anchor. Enroll every agent BEFORE turning this on.
AGENTIC_AUTH_IDENTITY_REQUIRED=false

# Transaction-token lifetime, seconds: one privileged call, minted right before it.
AGENTIC_AUTH_TRANSACTION_TOKEN_TTL_SECONDS=30

# Largest request body canonicalized for binding. Larger is refused, never forwarded unbound.
AGENTIC_AUTH_MAX_PRIVILEGED_BODY_BYTES=1048576

# Bearer allowed to begin/complete enrollment. Empty disables it; admin always works.
AGENTIC_AUTH_ENROLL_TOKEN=
# Single-use enrollment challenge lifetime, seconds.
AGENTIC_AUTH_ENROLL_CHALLENGE_TTL_SECONDS=120

# The organization's human IdP used for principal binding. Leave all three empty and every
# enrollment completes as `quarantined` (PRINCIPAL_IDP_NOT_CONFIGURED) rather than enrolling
# an agent nobody is accountable for.
AGENTIC_AUTH_PRINCIPAL_IDP_ISSUER=
AGENTIC_AUTH_PRINCIPAL_IDP_JWKS_URL=
AGENTIC_AUTH_PRINCIPAL_IDP_AUDIENCE=
# The ID-token claim that must equal "agent://<name>".
AGENTIC_AUTH_PRINCIPAL_BINDING_CLAIM=agent

# How long an offline verifier may run without refreshing revocation state, seconds.
AGENTIC_AUTH_REVOCATION_FRESHNESS_SECONDS=30

# Sidecar identity (both or neither). With a key, the sidecar signs an actor_token at every
# exchange and adds Agent-Identity on every forwarded call.
# AGENTIC_AUTH_SIDECAR_AGENT_NAME=support-agent
# AGENTIC_AUTH_SIDECAR_IDENTITY_KEY_PATH=/etc/agentic-auth/agent.pem
# Body cap for privileged calls the sidecar must buffer to bind (defaults to 1 MiB).
# AGENTIC_AUTH_SIDECAR_MAX_PRIVILEGED_BODY_BYTES=1048576
# The guarantee level this sidecar reports on every decision. A sidecar is per-hop, so `full`.
# AGENTIC_AUTH_SIDECAR_GUARANTEE_LEVEL=full

# ------------------------------------------------------------------ Phase 5
# Four independent controls, all off by default. With all off, Phase 1-4 behaviour is
# unchanged (SC-016).

# Let a session consent to a SUBSET of the data classes its pinned policy declares.
# Off: the consented set is the declared set, exactly as in Phases 2-4.
AGENTIC_AUTH_CONSENT_GRANULARITY_ENABLED=false
# Return a step-up challenge on a recoverable deny instead of a hard failure.
# REQUIRES consent granularity above — without it, step-up could never grant anything,
# and the process refuses to start.
AGENTIC_AUTH_STEP_UP_ENABLED=false
# How long an unanswered step-up challenge stays valid, seconds.
AGENTIC_AUTH_STEP_UP_CHALLENGE_TTL_SECONDS=300

# Route the sandboxed observation and manifest-proposal endpoints. Off: they answer 404.
AGENTIC_AUTH_SANDBOX_ENABLED=false
# A sandbox run ends here whether or not the agent stopped, seconds.
AGENTIC_AUTH_SANDBOX_RUN_DEADLINE_SECONDS=300

# What the control plane records when an enforcement point predates the guarantee field.
AGENTIC_AUTH_DEFAULT_GUARANTEE_LEVEL=full

# ------------------------------------------------------- Gateway (Phase 5)
# The shared enforcement service. Same decision core as the sidecar, deployed centrally.
# It never holds an agent's signing key: it RELAYS Agent-Identity and Actor-Token headers.
# AGENTIC_AUTH_GATEWAY_PDP_URL=http://localhost:8000
# AGENTIC_AUTH_GATEWAY_LISTEN_ADDR=0.0.0.0:8080
# A shared route table. Keys are "<agent>|<prefix>", or "|<prefix>" for any agent.
# AGENTIC_AUTH_GATEWAY_ROUTE_TABLE={"|/bank":{"url":"http://bank:9001","target":"mcp://bank/read_account","data_class":"account.read"}}
# Bound on the decision. Past it the call is refused, never retried.
# AGENTIC_AUTH_GATEWAY_DECISION_DEADLINE_MS=2000
# The level this gateway reports when it cannot verify relayed identity.
# AGENTIC_AUTH_GATEWAY_GUARANTEE_LEVEL=full

# ------------------------------------------------- Observability (Phase 6, spec 007)
# Off by default: a Phase 1-5 deployment behaves exactly as before, and the OpenTelemetry SDK
# is never imported. Install it with:  pip install -e '.[otel]'
AGENTIC_AUTH_TELEMETRY_ENABLED=false

# REQUIRED when telemetry is enabled. Keys the identity pseudonyms in traces/logs and the
# session-derived trace ids. Empty -> the exporter refuses to start and logs once; the process
# still serves traffic. There is no fallback to plaintext and none to an unkeyed digest.
# Generate with: openssl rand -hex 32
AGENTIC_AUTH_TELEMETRY_KEY=

# Export real agent names and the act chain instead of pseudonyms. Off by default; the state is
# itself exported as agentic_auth_telemetry_identity_disclosure so it can be alerted on.
# Metric labels are unaffected either way — they never carry identities, with no opt-in.
AGENTIC_AUTH_TELEMETRY_IDENTITY_DISCLOSURE=false

# Fraction of ALLOW spans kept. Refusals ignore this entirely: a denied, fail-closed,
# taint-blocked or unrecorded decision is always exported, at any ratio.
AGENTIC_AUTH_TELEMETRY_ALLOW_SAMPLE_RATIO=1.0

# Per sidecar, mirroring the four above. Each enforcement point configures its own telemetry;
# there is deliberately no fleet-wide switch.
# AGENTIC_AUTH_SIDECAR_TELEMETRY_ENABLED=true
# AGENTIC_AUTH_SIDECAR_TELEMETRY_KEY=
# AGENTIC_AUTH_SIDECAR_TELEMETRY_IDENTITY_DISCLOSURE=false
# AGENTIC_AUTH_SIDECAR_TELEMETRY_ALLOW_SAMPLE_RATIO=1.0

# Where telemetry goes is configured with the STANDARD OpenTelemetry variables, not names we
# invented — so an integrator who already sets these for their other services sets nothing new.
# Metrics are NOT exported this way: they stay on GET /metrics and GET /__agentic/metrics, and
# an OTLP-only pipeline collects them with the Collector's prometheus receiver
# (see https://authzai.dev/reference/telemetry-surface).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BSP_SCHEDULE_DELAY=5000

# --------------------------------------------------------------- Local dev
# Trust a self-signed capability-source certificate during discovery.
# SSL_CERT_FILE=/tmp/e2e-cert.pem
