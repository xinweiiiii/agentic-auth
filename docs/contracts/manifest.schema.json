          "type": "array"
        },
        "privileged": {
          "default": false,
          "title": "Privileged",
          "type": "boolean"
        },
        "binding_params": {
          "anyOf": [
            {
              "items": {
                "maxLength": 512,
                "pattern": "^(/([^/~]|~0|~1)*)+$",
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Params"
        }
      },
      "required": [
        "ref",
        "data_classes"
      ],
      "title": "ToolDecl",
      "type": "object"
    }
